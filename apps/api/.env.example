APP_NAME="LAAMACH MARBRE"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8100

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laamach_marbre
DB_USERNAME=laamach_marbre
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
# Exact public frontend origins. Never use a wildcard or include the admin origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100
# Explicit reverse-proxy IPs/CIDRs only; forwarded Host is never trusted.
TRUSTED_PROXIES=
HSTS_ENABLED=false

# Local defaults need no R2 credentials. Hosted staging/production require r2_private/r2_published.
MEDIA_PRIVATE_DISK=local
MEDIA_PUBLISHED_DISK=local_published
# Required only for project video inspection/remux; absolute paths may be supplied.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=laamach-marbre-private
R2_PUBLISHED_BUCKET=laamach-marbre-published
R2_PUBLISHED_URL=

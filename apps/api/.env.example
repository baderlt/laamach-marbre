R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=laamach-marbre-private
R2_PUBLISHED_BUCKET=laamach-marbre-published
R2_PUBLISHED_URL=

SITE_URL=http://127.0.0.1:3100
# Server-side only; never expose the backend origin through NEXT_PUBLIC_*.
LARAVEL_API_URL=http://127.0.0.1:8100
API_TIMEOUT_MS=3000
# Launch policy: never enable indexing before explicit launch approval.
SITE_ENV=local
SITE_INDEXING_ENABLED=false
# Exact published-media origins, comma-separated. Required for an external CDN.
MEDIA_ORIGINS=
HSTS_ENABLED=false
# Optional separate QA output: .next-qa
# NEXT_DIST_DIR=.next-qa
